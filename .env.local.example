# Copy this file to .env.local for local development.
# For production, add the same keys/values in Vercel:
# Project -> Settings -> Environment Variables.

# --- Contact form email (Google Workspace SMTP) ---
# SMTP_HOST: always smtp.gmail.com for Google Workspace / Gmail.
SMTP_HOST=smtp.gmail.com

# SMTP_PORT: 465 (SSL). Leave as-is unless your provider says otherwise.
SMTP_PORT=465

# SMTP_USER: the full mailbox address that will authenticate and send the email.
# Must be a real Google Workspace mailbox, e.g. info@nervestacksolutions.com
SMTP_USER=

# SMTP_PASSWORD: a Google "App Password" for that mailbox — NOT its normal login password.
# Generate one at: https://myaccount.google.com/apppasswords
#   1. The Google account for info@nervestacksolutions.com must have 2-Step Verification turned on
#      (Google Workspace admin can enforce/enable this under Security settings if needed).
#   2. Go to https://myaccount.google.com/apppasswords (while signed in as info@nervestacksolutions.com).
#   3. Create an app password named e.g. "NerveStack Website", choose type "Mail".
#   4. Copy the 16-character password Google shows you (spaces don't matter) and paste it here.
SMTP_PASSWORD=

# CONTACT_TO_EMAIL: where submitted contact form leads are delivered.
CONTACT_TO_EMAIL=info@nervestacksolutions.com

# --- Optional: also forward every lead to an n8n webhook ---
# Leave blank to skip. If used, this should be a "Webhook" trigger node's Production URL in n8n.
N8N_WEBHOOK_URL=
